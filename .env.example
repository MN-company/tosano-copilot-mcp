# Local-only MCP server. Keep this file private and do not paste credentials here.
PORT=3788
# Optional fallback: v0.3 automatically captures a fresh hash from the Chromium browser's product requests.
TOSANO_CONTEXT_HASH=
# Optional: set ONLY when actual GET cart URL was observed via DevTools.
TOSANO_CART_READ_PATH=
# Cart writes OFF until real session/account/cart verification.
ALLOW_CART_WRITES=false
# The persisted profile lives under ~/.tosano-copilot/browser-profile.
TOSANO_BROWSER_CHANNEL=chromium

# v0.4 site features, each OFF until tested live with explicit consent.
ALLOW_LIST_WRITES=false
ALLOW_ORDER_WRITES=false
# Places REAL orders after per-order approval. Keep false until you decide otherwise.
ALLOW_CHECKOUT=false
